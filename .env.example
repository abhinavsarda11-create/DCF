# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY / GROK_API_KEY: API key for Groq Cloud (gsk_...) or Grok (xAI) to power the Dawn Assistant chatbot.
# If not specified, the chatbot automatically uses the server-side intelligent AI engine.
GROQ_API_KEY="MY_GROQ_API_KEY"
GROK_API_KEY="MY_GROK_API_KEY"

# GROK_BASE_URL: Base URL for Grok API endpoint (default: https://api.groq.com/openai/v1 or https://api.x.ai/v1).
GROK_BASE_URL="https://api.groq.com/openai/v1"

# GROK_MODEL / GROQ_MODEL: Model identifier (e.g., openai/gpt-oss-120b, openai/gpt-oss-20b, grok-beta).
GROQ_MODEL="openai/gpt-oss-120b"
GROK_MODEL="grok-beta"

# DATABASE_URL: PostgreSQL relational database connection string for persistent certificates and chat conversations.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# If not specified or unreachable, the server safely uses resilient in-memory relational storage.
DATABASE_URL="postgresql://postgres:password@localhost:5432/dawn_child_foundation"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
